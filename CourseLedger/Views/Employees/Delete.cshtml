@model CourseLedger.DataAccess.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1><i class="bi bi-trash me-2"></i>Delete Employee</h1>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h4 class="text-danger">Are you sure you want to delete this employee?</h4>
        <dl class="row mt-3">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UserName)</dt>
            <dd class="col-sm-9"><span class="mono-id">@Html.DisplayFor(model => model.UserName)</span></dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Roles)</dt>
            <dd class="col-sm-9">
                @if (Model.Roles != null && Model.Roles.Any())
                {
                    @string.Join(", ", Model.Roles.Select(r => r.Role1))
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>
        </dl>

        <div class="d-flex gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                    data-delete-title="Delete Employee"
                    data-delete-action="@Url.Action("Delete", new { id = Model.Id })"
                    data-delete-message="Permanently delete @Model.Name? Role assignments will be removed."
                    data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = Model.Id.ToString() }))'>
                <i class="bi bi-trash me-1"></i>Delete Employee
            </button>
        </div>
    </div>
</div>
