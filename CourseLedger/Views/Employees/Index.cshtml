@model IEnumerable<CourseLedger.DataAccess.Employee>

@{
    ViewData["Title"] = "Employees";
    var hasItems = Model.Any();
}

<div class="page-header">
    <h1><i class="bi bi-people-fill me-2"></i>Employees</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Create New Employee
    </a>
</div>

@if (!hasItems)
{
    ViewData["EmptyIcon"] = "bi-people";
    ViewData["EmptyMessage"] = "No employees yet.";
    ViewData["EmptyActionText"] = "Create First Employee";
    ViewData["EmptyActionController"] = "Employees";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="card shadow-sm border-0 table-desktop">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.Roles)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                                <td><span class="badge badge-info mono-id">@Html.DisplayFor(modelItem => item.UserName)</span></td>
                                <td>
                                    @if (item.Roles != null && item.Roles.Any())
                                    {
                                        @foreach (var role in item.Roles)
                                        {
                                            <span class="badge badge-role me-1">@role.Role1</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No roles assigned</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-edit me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-delete-title="Delete Employee"
                                            data-delete-action="@Url.Action("Delete", new { id = item.Id })"
                                            data-delete-message="Are you sure you want to delete @item.Name? Their role assignments will also be removed."
                                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = item.Id.ToString() }))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mobile-card-list">
        @foreach (var item in Model)
        {
            <div class="mobile-data-card">
                <strong>@item.Name</strong>
                <div class="mt-1"><span class="badge badge-info mono-id">@item.UserName</span></div>
                <div class="mt-2">
                    @if (item.Roles != null && item.Roles.Any())
                    {
                        @foreach (var role in item.Roles)
                        {
                            <span class="badge badge-role me-1">@role.Role1</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">No roles assigned</span>
                    }
                </div>
                <div class="card-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-edit"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                            data-delete-title="Delete Employee"
                            data-delete-action="@Url.Action("Delete", new { id = item.Id })"
                            data-delete-message="Delete @item.Name?"
                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = item.Id.ToString() }))'>
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}
