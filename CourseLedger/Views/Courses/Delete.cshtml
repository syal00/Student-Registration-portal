@model CourseLedger.DataAccess.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h4 class="text-danger">Are you sure you want to delete this course?</h4>
        <dl class="row mt-3">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9 mono-id">@Html.DisplayFor(model => model.Code)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>
        </dl>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                    data-delete-title="Delete Course"
                    data-delete-action="@Url.Action("Delete", new { id = Model.Code })"
                    data-delete-message="Delete @Model.Title? All associated academic records will be removed."
                    data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = Model.Code }))'>
                <i class="bi bi-trash me-1"></i>Delete Course
            </button>
        </div>
    </div>
</div>
