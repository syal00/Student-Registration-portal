@model IEnumerable<CourseLedger.DataAccess.Role>

@{
    ViewData["Title"] = "Roles";
    var hasItems = Model.Any();
}

<div class="page-header">
    <h1><i class="bi bi-shield-check me-2"></i>Roles</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Create New Role
    </a>
</div>

@if (!hasItems)
{
    ViewData["EmptyIcon"] = "bi-shield";
    ViewData["EmptyMessage"] = "No roles yet.";
    ViewData["EmptyActionText"] = "Create First Role";
    ViewData["EmptyActionController"] = "Roles";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="card shadow-sm border-0 table-desktop">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Role Name</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="mono-id">@item.Id</span></td>
                                <td><strong>@item.Role1</strong></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-edit me-1"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-delete-title="Delete Role"
                                            data-delete-action="@Url.Action("Delete", new { id = item.Id })"
                                            data-delete-message="Delete role @item.Role1? Employee assignments will be removed."
                                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = item.Id.ToString() }))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mobile-card-list">
        @foreach (var item in Model)
        {
            <div class="mobile-data-card">
                <strong>@item.Role1</strong>
                <div class="mono-id text-muted small">ID: @item.Id</div>
                <div class="card-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-edit"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                            data-delete-title="Delete Role"
                            data-delete-action="@Url.Action("Delete", new { id = item.Id })"
                            data-delete-message="Delete @item.Role1?"
                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = item.Id.ToString() }))'>
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}
