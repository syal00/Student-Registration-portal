@model CourseLedger.DataAccess.Role
@{ ViewData["Title"] = "Delete Role"; }

<h1>Delete Role</h1>
<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h4 class="text-danger">Are you sure you want to delete this role?</h4>
        <dl class="row mt-3">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9 mono-id">@Model.Id</dd>
            <dt class="col-sm-3">Role Name</dt>
            <dd class="col-sm-9">@Model.Role1</dd>
        </dl>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                    data-delete-title="Delete Role"
                    data-delete-action="@Url.Action("Delete", new { id = Model.Id })"
                    data-delete-message="Delete @Model.Role1?"
                    data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = Model.Id.ToString() }))'>
                <i class="bi bi-trash me-1"></i>Delete Role
            </button>
        </div>
    </div>
</div>
