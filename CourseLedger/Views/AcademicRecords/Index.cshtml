@model IEnumerable<CourseLedger.DataAccess.AcademicRecord>

@{
    ViewData["Title"] = "Academic Records";
    var hasItems = Model.Any();
}

<div class="page-header">
    <h1><i class="bi bi-clipboard-data-fill me-2"></i>Academic Records</h1>
    <div class="page-actions">
        <a asp-action="EditAll" asp-route-sortOrder="@ViewData["CurrentSort"]" class="btn btn-primary">
            <i class="bi bi-pencil-square me-2"></i>Edit All Grades
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Create New
        </a>
    </div>
</div>

@if (!hasItems)
{
    ViewData["EmptyIcon"] = "bi-clipboard-data";
    ViewData["EmptyMessage"] = "No academic records yet.";
    ViewData["EmptyActionText"] = "Create First Record";
    ViewData["EmptyActionController"] = "AcademicRecords";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="card shadow-sm border-0 table-desktop">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewData["CourseSortParam"]" class="text-decoration-none">
                                    <i class="bi bi-sort-alpha-down me-1"></i>Course
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewData["StudentSortParam"]" class="text-decoration-none">
                                    <i class="bi bi-sort-alpha-down me-1"></i>Student
                                </a>
                            </th>
                            <th>@Html.DisplayNameFor(model => model.Grade)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@Html.DisplayFor(modelItem => item.CourseCodeNavigation.Title)</strong>
                                    <br />
                                    <small class="text-muted mono-id">@Html.DisplayFor(modelItem => item.CourseCodeNavigation.Code)</small>
                                </td>
                                <td>
                                    <strong>@Html.DisplayFor(modelItem => item.Student.Name)</strong>
                                    <br />
                                    <small class="text-muted mono-id">@Html.DisplayFor(modelItem => item.Student.Id)</small>
                                </td>
                                <td>
                                    @if (item.Grade.HasValue)
                                    {
                                        var gradeClass = item.Grade >= 60 ? "grade-pass" : item.Grade >= 50 ? "grade-warn" : "grade-fail";
                                        <span class="grade-badge @gradeClass">@item.Grade%</span>
                                    }
                                    else
                                    {
                                        <span class="grade-badge grade-none">No grade</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-studentId="@item.StudentId" asp-route-courseCode="@item.CourseCode" class="btn btn-sm btn-action btn-action-edit me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-delete-title="Delete Academic Record"
                                            data-delete-action="@Url.Action("Delete")"
                                            data-delete-message="Are you sure you want to delete the record for @item.Student.Name in @item.CourseCodeNavigation.Title?"
                                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["studentId"] = item.StudentId, ["courseCode"] = item.CourseCode }))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mobile-card-list">
        @foreach (var item in Model)
        {
            <div class="mobile-data-card">
                <strong>@item.CourseCodeNavigation.Title</strong>
                <div class="text-muted mono-id small">@item.CourseCodeNavigation.Code</div>
                <div class="mt-2"><strong>@item.Student.Name</strong> <span class="mono-id text-muted small">(@item.Student.Id)</span></div>
                <div class="mt-2">
                    @if (item.Grade.HasValue)
                    {
                        var gradeClass = item.Grade >= 60 ? "grade-pass" : item.Grade >= 50 ? "grade-warn" : "grade-fail";
                        <span class="grade-badge @gradeClass">@item.Grade%</span>
                    }
                    else
                    {
                        <span class="grade-badge grade-none">No grade</span>
                    }
                </div>
                <div class="card-actions">
                    <a asp-action="Edit" asp-route-studentId="@item.StudentId" asp-route-courseCode="@item.CourseCode" class="btn btn-sm btn-action btn-action-edit"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                            data-delete-title="Delete Academic Record"
                            data-delete-action="@Url.Action("Delete")"
                            data-delete-message="Delete record for @item.Student.Name?"
                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["studentId"] = item.StudentId, ["courseCode"] = item.CourseCode }))'>
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}
