@{
    ViewData["Title"] = "Home";
}

<div class="home-hero text-center mb-4 mb-md-5">
    <h1 class="page-hero-title fw-bold mb-3">
        <i class="bi bi-journal-bookmark-fill me-2 me-md-3"></i>Welcome to CourseLedger
    </h1>
    <p class="lead text-muted home-hero-subtitle">Manage courses, students, academic records, employees, and roles with ease</p>
</div>

<div class="row g-3 g-md-4 feature-grid">
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card h-100 feature-card">
            <div class="card-body text-center p-3 p-md-4">
                <i class="bi bi-book-fill feature-icon feature-icon--courses mb-3"></i>
                <h4 class="card-title fw-bold mb-2 mb-md-3">Courses</h4>
                <p class="card-text text-muted mb-3 mb-md-4">Manage course information, descriptions, and fees</p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-card btn-card--courses w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>View Courses
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card h-100 feature-card">
            <div class="card-body text-center p-3 p-md-4">
                <i class="bi bi-person-badge-fill feature-icon feature-icon--students mb-3"></i>
                <h4 class="card-title fw-bold mb-2 mb-md-3">Students</h4>
                <p class="card-text text-muted mb-3 mb-md-4">Register and manage student records</p>
                <a asp-controller="Students" asp-action="Index" class="btn btn-card btn-card--students w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>View Students
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card h-100 feature-card">
            <div class="card-body text-center p-3 p-md-4">
                <i class="bi bi-clipboard-data-fill feature-icon feature-icon--records mb-3"></i>
                <h4 class="card-title fw-bold mb-2 mb-md-3">Academic Records</h4>
                <p class="card-text text-muted mb-3 mb-md-4">View and edit student grades and academic performance</p>
                <a asp-controller="AcademicRecords" asp-action="Index" class="btn btn-card btn-card--records w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>View Records
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card h-100 feature-card">
            <div class="card-body text-center p-3 p-md-4">
                <i class="bi bi-people-fill feature-icon feature-icon--employees mb-3"></i>
                <h4 class="card-title fw-bold mb-2 mb-md-3">Employees</h4>
                <p class="card-text text-muted mb-3 mb-md-4">Manage employee information, roles, and access</p>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-card btn-card--employees w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>View Employees
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card h-100 feature-card">
            <div class="card-body text-center p-3 p-md-4">
                <i class="bi bi-shield-check feature-icon feature-icon--roles mb-3"></i>
                <h4 class="card-title fw-bold mb-2 mb-md-3">Roles</h4>
                <p class="card-text text-muted mb-3 mb-md-4">Define job titles and role assignments</p>
                <a asp-controller="Roles" asp-action="Index" class="btn btn-card btn-card--roles w-100">
                    <i class="bi bi-arrow-right-circle me-2"></i>View Roles
                </a>
            </div>
        </div>
    </div>
</div>
