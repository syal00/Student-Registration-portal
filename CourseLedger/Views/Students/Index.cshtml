@model IEnumerable<CourseLedger.DataAccess.Student>

@{
    ViewData["Title"] = "Students";
    var hasItems = Model.Any();
}

<div class="page-header">
    <h1><i class="bi bi-person-badge-fill me-2"></i>Students</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Create New Student
    </a>
</div>

@if (!hasItems)
{
    ViewData["EmptyIcon"] = "bi-person-badge";
    ViewData["EmptyMessage"] = "No students yet.";
    ViewData["EmptyActionText"] = "Create First Student";
    ViewData["EmptyActionController"] = "Students";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="card shadow-sm border-0 table-desktop">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Id)</th>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="mono-id">@Html.DisplayFor(modelItem => item.Id)</span></td>
                                <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-view me-1"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-edit me-1"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-delete-title="Delete Student"
                                            data-delete-action="@Url.Action("Delete", new { id = item.Id })"
                                            data-delete-message="Delete @item.Name? Associated academic records will also be removed."
                                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = item.Id }))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mobile-card-list">
        @foreach (var item in Model)
        {
            <div class="mobile-data-card">
                <strong>@item.Name</strong>
                <div class="mono-id text-muted small">@item.Id</div>
                <div class="card-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-view"><i class="bi bi-eye"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-action btn-action-edit"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn btn-sm btn-action btn-action-delete"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                            data-delete-title="Delete Student"
                            data-delete-action="@Url.Action("Delete", new { id = item.Id })"
                            data-delete-message="Delete @item.Name?"
                            data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = item.Id }))'>
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}
