@model CourseLedger.DataAccess.Student
@{ ViewData["Title"] = "Student Details"; }

<h1>Student Details</h1>
<dl class="row mt-4">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
