@model CourseLedger.DataAccess.Student
@{ ViewData["Title"] = "Delete Student"; }

<h1>Delete Student</h1>
<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h4 class="text-danger">Are you sure you want to delete this student?</h4>
        <dl class="row mt-3">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-9 mono-id">@Html.DisplayFor(model => model.Id)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
        </dl>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                    data-delete-title="Delete Student"
                    data-delete-action="@Url.Action("Delete", new { id = Model.Id })"
                    data-delete-message="Delete @Model.Name? Associated academic records will be removed."
                    data-delete-fields='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = Model.Id }))'>
                <i class="bi bi-trash me-1"></i>Delete Student
            </button>
        </div>
    </div>
</div>
